# Stage 1: Build the Angular Application
FROM node:24.22.0-alpine AS build
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy application source and build it
COPY . .
RUN npm run build -- -c=production

# Stage 2: Serve Application via NGINX
FROM nginx:1.31.6-alpine-slim

# Copy custom NGINX configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build output to NGINX HTML server directory
# Note: Adjust 'project-name' to match the actual name in your angular.json file
COPY --from=build /app/dist/simple-angular-app/browser /usr/share/nginx/html

EXPOSE 80
# CMD ["nginx", "-g", "daemon off;"] # Optional for alpine image. Purpose: In order to tell docker to run nginx in foreground rather then background